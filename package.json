{
  "name": "otf",
  "version": "0.1.0",
  "private": true,
  "description": "OTF - an OT/ICS cyber range and CTF platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --experimental-sqlite scripts/migrate.mjs",
    "db:reset": "node --experimental-sqlite scripts/reset.mjs",
    "content:validate": "node --experimental-sqlite scripts/content.mjs validate",
    "content:sync": "node --experimental-sqlite scripts/content.mjs sync",
    "seed": "node --experimental-sqlite scripts/seed.mjs",
    "setup": "npm run db:migrate && npm run content:sync && npm run seed",
    "test": "node --experimental-sqlite --test tests/*.test.mjs"
  },
  "dependencies": {
    "marked": "^16.4.0",
    "next": "^16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  }
}
