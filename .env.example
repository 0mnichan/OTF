# Secret used to sign session cookies AND derive per-user dynamic flags.
# Generate with: openssl rand -hex 32
OTF_SECRET=change-me-in-production-openssl-rand-hex-32

# SQLite database location.
OTF_DB_PATH=./data/otf.db

# Public base URL, used for absolute links and cookie scoping.
OTF_BASE_URL=http://localhost:3000

# Orchestrator service (lab spawn/reap). Leave unset to run the platform
# in content-only mode with lab controls disabled.
OTF_ORCHESTRATOR_URL=http://localhost:4000
OTF_ORCHESTRATOR_TOKEN=change-me-too

# Set to "1" to allow open registration. Otherwise invite-only.
OTF_OPEN_REGISTRATION=1

# --- Google sign-in (optional) ---
# Create an OAuth 2.0 Client (type: Web application) in Google Cloud Console.
# Authorized redirect URI must be exactly: <OTF_BASE_URL>/api/auth/google/callback
# Leave unset to disable the "Sign in with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public base URL, used to build the OAuth redirect URI (must match Google).
OTF_BASE_URL=http://localhost:3000
