#!/usr/bin/env bash
# mbscan <cidr> - find Modbus/TCP hosts and fingerprint them.
CIDR="${1:-10.13.37.0/24}"
echo "[*] scanning $CIDR for Modbus/TCP (502)..."
nmap -p502 --open -oG - "$CIDR" | awk '/502\/open/{print $2}' | while read -r ip; do
  echo "[+] $ip"
  nmap -p502 --script modbus-discover "$ip" 2>/dev/null | grep -A6 modbus-discover || true
done
