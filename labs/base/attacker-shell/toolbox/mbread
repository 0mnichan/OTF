#!/usr/bin/env python3
"""mbread <host> <start> <count> - read holding registers, print raw + ASCII."""
import sys, struct
from pymodbus.client import ModbusTcpClient
host, start, count = sys.argv[1], int(sys.argv[2]), int(sys.argv[3])
c = ModbusTcpClient(host, port=502, timeout=3)
if not c.connect():
    sys.exit(f"could not connect to {host}:502")
rr = c.read_holding_registers(address=start, count=count)
c.close()
if rr.isError():
    sys.exit(str(rr))
print("registers:", rr.registers)
ascii_bytes = b"".join(struct.pack(">H", r) for r in rr.registers)
printable = "".join(chr(b) if 32 <= b < 127 else "." for b in ascii_bytes)
print("ascii    :", printable)
